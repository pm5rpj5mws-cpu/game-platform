# Fuer docker-compose: Zugangsdaten der Postgres-Datenbank.
# Ohne .env-Datei greifen die Fallback-Werte goki/goki/goki aus docker-compose.yml (nur fuer lokale Entwicklung geeignet).
POSTGRES_USER=goki
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=goki

# true, wenn die App per HTTPS ausgeliefert wird (Produktion). Bei lokalem http:// muss es false sein,
# sonst wird das Session-Cookie vom Browser verworfen und der Login schlaegt fehl.
COOKIE_SECURE=false

# Nur relevant, wenn der Server ausserhalb von docker-compose direkt gestartet wird (node server/index.js)
# und sich mit einer eigenen Postgres-Instanz verbinden soll.
DATABASE_URL=postgres://user:password@host:5432/dbname
PORT=3000
